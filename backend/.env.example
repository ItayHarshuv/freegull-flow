DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freegull_flow
PORT=4000
CLUB_ID=FREEGULL_MAIN
BLOB_IMPORT_URL=https://jsonblob.com/api/jsonBlob/1340277874983059456

# Google Calendar (one-way availability sync)
# Preferred: service account + shared calendar.
# 1. Create a service account in Google Cloud with Calendar API enabled.
# 2. Share your target Google Calendar with the service account email as editor.
# 3. Set GOOGLE_AVAILABILITY_CALENDAR_ID to that shared calendar's ID.
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Fallback: user OAuth refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=

GOOGLE_AVAILABILITY_CALENDAR_NAME=זמינות עובדים
# Recommended with service accounts; skips lookup by name
GOOGLE_AVAILABILITY_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Jerusalem
