DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freegull_flow
PORT=4000
CLUB_ID=FREEGULL_MAIN
BLOB_IMPORT_URL=https://jsonblob.com/api/jsonBlob/1340277874983059456

# Google Calendar (one-way availability sync)
# Setup (manual): create OAuth client in Google Cloud Console, get a refresh token
# for the Google user that owns/manages the shared calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_AVAILABILITY_CALENDAR_NAME=זמינות עובדים
# Optional: set if you want to skip resolving/creating by name
GOOGLE_AVAILABILITY_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Jerusalem
